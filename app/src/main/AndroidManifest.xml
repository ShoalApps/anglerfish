<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <queries>
        <package android:name="io.github.shoalapps.shoal" />
        <package android:name="io.github.shoalapps.shoal.debug" />
    </queries>

    <application
        android:name=".PufferApp"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@style/Theme.Anglerfish"
        android:supportsRtl="true"
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|keyboard|navigation|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- reddit.com links can open here (choose Anglerfish in Android's "open by default"). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="reddit.com" />
                <data android:host="www.reddit.com" />
                <data android:host="old.reddit.com" />
                <data android:host="redd.it" />
            </intent-filter>
            <!-- Share a Reddit link to Anglerfish. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>
        <!-- Home-screen widget. -->
        <receiver android:name=".widget.AnglerfishWidgetReceiver" android:exported="false" android:label="Anglerfish">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_info" />
        </receiver>
        <!-- Error reports start only with consent (Telemetry.kt). -->
        <meta-data android:name="io.sentry.auto-init" android:value="false" />
    </application>
</manifest>
